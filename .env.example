# ---------------------------------------------------------------------------
# WALLINE 沃澜 — environment template
# Copy to `.env` (local) or set these variables in your host's dashboard.
# ---------------------------------------------------------------------------

# Public site URL, used for absolute links, payment return URLs and metadata.
# Example: https://shop.example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SQLite database file. Defaults to ./data/walline.db
# In production point it at a persistent disk, e.g. /var/lib/walline/walline.db
# DATABASE_PATH=./data/walline.db

# ---------------------------------------------------------------------------
# Checkout / payments
# ---------------------------------------------------------------------------

# When DEMO_PAYMENT is not "false", every payment method falls back to the
# one-click demo checkout (no real money moves). Set to "false" in production.
DEMO_PAYMENT=true

# Stripe (card payments worldwide). Set both keys to enable the Stripe flow.
# STRIPE_SECRET_KEY=sk_test_...

# PayPal (international wallets). Set both keys to enable the PayPal flow.
# PAYPAL_CLIENT_ID=...
# PAYPAL_CLIENT_SECRET=...
# Use "live" to leave the PayPal sandbox. Defaults to sandbox.
# PAYPAL_ENV=sandbox

# Bank transfer is always available as an offline payment method.

# ---------------------------------------------------------------------------
# Admin console (/zh/admin or /en/admin)
# ---------------------------------------------------------------------------

# Default demo password is "walline-admin" — change it before going live.
# ADMIN_PASSWORD=change-me

# Optional extra secret mixed into the admin session token signature.
# ADMIN_SECRET=change-me-too
