{
  "name": "walline-store",
  "version": "1.0.0",
  "private": true,
  "description": "WALLINE 沃澜 — bilingual e-commerce storefront for architectural trim, wood-fiber profiles and wall panels",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
