    "next": "16.4.3",
    "postcss": "8.5.23",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "styled-jsx": "5.1.6"
  },
  "optionalDependencies": {
    "@next/swc-win32-x64-msvc": "16.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18",
